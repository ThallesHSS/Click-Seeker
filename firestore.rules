rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil e saves: cada pessoa só enxerga e mexe no que é dela.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Toda conta nasce "jogador". Só vira "dev" quem souber o código abaixo
      // (o código fica aqui nas regras, que o navegador não consegue ler).
      // >>> TROQUE 'PassioXPI@9_' por um código seu <<<
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['papel', 'nome', 'criadoEm', 'codigoDev'])
        && (
          request.resource.data.papel == 'jogador'
          || (request.resource.data.papel == 'dev'
              && request.resource.data.codigoDev == 'troque-este-codigo')
        );

      // Ninguém muda o próprio papel depois de criado (para virar dev depois,
      // edite o campo "papel" direto no console do Firebase).
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.papel == resource.data.papel;

      match /saves/{saveId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.dados is string
          && request.resource.data.dados.size() < 60000;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
